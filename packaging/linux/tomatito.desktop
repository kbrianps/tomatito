[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Actions=alternar;pular;encerrar;

[Desktop Action alternar]
Name=Iniciar ou pausar foco
Exec={{exec}} --acao=alternar

[Desktop Action pular]
Name=Pular fase
Exec={{exec}} --acao=pular

[Desktop Action encerrar]
Name=Encerrar sessão
Exec={{exec}} --acao=encerrar
