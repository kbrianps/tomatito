// Publicação da versão web no Cloudflare Workers (arquivos estáticos).
// Em 02/10/2026 a conta já não aceitava `wrangler pages deploy` ("Delegating to
// the latest version of Cloudflare Pages, now part of Cloudflare Workers"),
// então o deploy é `wrangler deploy` com esta configuração. O _headers do
// dist-web vale do mesmo jeito. Ver docs/web/publicar.md.
{
  "name": "tomatito",
  "compatibility_date": "2026-09-26",
  // O endereço próprio (06/10/2026). O tomatito.kbrianps.workers.dev continua
  // no ar: os dados da web são por endereço, e quem já usava o antigo não os
  // perde (dá para levá-los com Exportar e Importar).
  "routes": [{ "pattern": "tomatito.kbrianps.com", "custom_domain": true }],
  // Com `routes`, o workers.dev sai por padrão: fica ligado de propósito.
  "workers_dev": true,
  "assets": {
    "directory": "./dist-web",
    // O app é uma página só: caminho desconhecido devolve o index.html.
    "not_found_handling": "single-page-application"
  }
}
