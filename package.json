{
  "name": "tomatito",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-theme-css.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-theme-css.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "shot": "node scripts/preview/shot.mjs",
    "shot:webkit": "node scripts/preview/webkit-shot.mjs",
    "test": "node --test",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:debug": "tauri build --debug --no-bundle --config src-tauri/tauri.dev.conf.json",
    "wasm": "node scripts/web/wasm.mjs",
    "test:wasm": "node scripts/web/testar-wasm.mjs",
    "predev:web": "node scripts/build-theme-css.mjs && node scripts/web/wasm.mjs",
    "dev:web": "vite --config vite.web.config.js",
    "prebuild:web": "node scripts/build-theme-css.mjs && node scripts/web/wasm.mjs",
    "build:web": "vite build --config vite.web.config.js",
    "serve:web": "vite preview --config vite.web.config.js"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "1.1.343",
    "@tauri-apps/cli": "2.12.0",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@fluentui/tokens": "1.0.0-alpha.24",
    "@fluentui/web-components": "3.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@microsoft/fast-element": "3.0.3",
    "@microsoft/focusgroup-polyfill": "1.6.0",
    "@tauri-apps/api": "2.12.0"
  },
  "imports": {
    "#plataforma": {
      "tomatito-web": "./src/platform/web/index.js",
      "default": "./src/platform/tauri.js"
    }
  }
}
